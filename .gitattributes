# 统一换行符策略
* text=auto

# PowerShell 脚本必须是 CRLF + UTF-8 BOM，否则 Windows PowerShell 5.1 中文乱码、语法错误
*.ps1 text eol=crlf working-tree-encoding=UTF-8
*.bat text eol=crlf
*.cmd text eol=crlf

# 代码文件用 LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.jar binary
*.exe binary
*.dll binary
*.parquet binary
*.db binary